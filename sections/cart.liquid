<script>
  (() => {
    /*
     * This script uses event delegation so it continues
     * working after we replace the cart HTML with updated
     * server-rendered markup.
     */

    if (window.BentleyCartInitialized) return;
    window.BentleyCartInitialized = true;

    const getCartRoot = () => {
      return document.querySelector('[data-cart-section="{{ section.id }}"]');
    };

    const setLoading = (cartItem, state) => {
      if (!cartItem) return;

      cartItem.classList.toggle('is-loading', state);

      cartItem.querySelectorAll('button, input').forEach((element) => {
        element.disabled = state;
      });
    };

    /*
     * Refresh the server-rendered cart HTML.
     *
     * This keeps Liquid prices, discount information,
     * totals and item quantities perfectly synchronized
     * with Shopify.
     */
    const refreshCartMarkup = async () => {
      const currentRoot = getCartRoot();

      if (!currentRoot) return;

      const response = await fetch(window.location.href, {
        headers: {
          Accept: 'text/html',
        },
      });

      if (!response.ok) {
        throw new Error('Unable to refresh cart.');
      }

      const html = await response.text();

      const parser = new DOMParser();
      const documentResponse = parser.parseFromString(html, 'text/html');

      const updatedRoot = documentResponse.querySelector('[data-cart-section="{{ section.id }}"]');

      if (!updatedRoot) {
        throw new Error('Updated cart markup could not be found.');
      }

      currentRoot.innerHTML = updatedRoot.innerHTML;
    };

    /*
     * Update common cart-count elements around the theme.
     *
     * We also fire a custom event so your header or other
     * custom sections can listen for the updated cart.
     */
    const updateGlobalCartCount = (cart) => {
      const selectors = [
        '[data-cart-count]',
        '[data-cart-item-count-header]',
        '.cart-count',
        '.cart-count-bubble span',
        '#cart-icon-bubble .cart-count-bubble span',
      ];

      selectors.forEach((selector) => {
        document.querySelectorAll(selector).forEach((element) => {
          element.textContent = cart.item_count;
        });
      });

      document.dispatchEvent(
        new CustomEvent('cart:updated', {
          detail: {
            cart: cart,
          },
        })
      );
    };

    const changeCartLine = async (cartItem, quantity) => {
      if (!cartItem) return;

      const key = cartItem.dataset.cartKey;

      if (!key) return;

      quantity = Math.max(0, parseInt(quantity, 10) || 0);

      setLoading(cartItem, true);

      try {
        const root =
          window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/';

        const response = await fetch(`${root}cart/change.js`, {
          method: 'POST',

          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },

          body: JSON.stringify({
            id: key,
            quantity: quantity,
          }),
        });

        const cart = await response.json();

        if (!response.ok) {
          throw new Error(cart.description || cart.message || 'Unable to update cart.');
        }

        updateGlobalCartCount(cart);

        await refreshCartMarkup();
      } catch (error) {
        console.error('Cart update error:', error);

        setLoading(cartItem, false);

        window.alert(error.message || 'There was a problem updating your cart.');
      }
    };

    /*
     * Click handlers
     */
    document.addEventListener('click', (event) => {
      const increaseButton = event.target.closest('[data-cart-increase]');

      const decreaseButton = event.target.closest('[data-cart-decrease]');

      const removeButton = event.target.closest('[data-cart-remove]');

      /*
       * Increase
       */
      if (increaseButton) {
        const cartItem = increaseButton.closest('[data-cart-item]');

        const input = cartItem.querySelector('[data-cart-quantity-input]');

        const quantity = (parseInt(input.value, 10) || 0) + 1;

        changeCartLine(cartItem, quantity);

        return;
      }

      /*
       * Decrease
       */
      if (decreaseButton) {
        const cartItem = decreaseButton.closest('[data-cart-item]');

        const input = cartItem.querySelector('[data-cart-quantity-input]');

        const quantity = Math.max(0, (parseInt(input.value, 10) || 0) - 1);

        changeCartLine(cartItem, quantity);

        return;
      }

      /*
       * Remove
       */
      if (removeButton) {
        const cartItem = removeButton.closest('[data-cart-item]');

        changeCartLine(cartItem, 0);
      }
    });

    /*
     * Manual quantity typing
     */
    document.addEventListener('change', (event) => {
      if (!event.target.matches('[data-cart-quantity-input]')) {
        return;
      }

      const input = event.target;

      const cartItem = input.closest('[data-cart-item]');

      changeCartLine(cartItem, input.value);
    });
  })();
</script>


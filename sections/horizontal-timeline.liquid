{{ 'variables.css' | asset_url | stylesheet_tag }}

<section
  id="SideScrollTimeline-{{ section.id }}"
  class="timeline-container full-width"
>
  <div class="timeline-pin">
    {% if section.settings.heading != blank %}
      <div class="timeline-header">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="timeline-viewport">
      <div class="timeline-track">
        {% for block in section.blocks %}
          <div
            class="timeline-card"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image != blank %}
              <div class="timeline-card__image">
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 750px) 40vw, 85vw'
                }}
              </div>
            {% endif %}

            <div class="timeline-card__content">
              {% if block.settings.heading != blank %}
                <h3 class="timeline-card__heading">
                  {{ block.settings.heading }}
                </h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="timeline-card__text rte">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .timeline-container {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .timeline-pin {
    width: 100%;
    min-height: 100vh;

    display: flex;
    flex-direction: column;
    justify-content: center;

    overflow: hidden;
  }

  /* -----------------------------
     SECTION HEADING
  ----------------------------- */

  .timeline-header {
    width: var(--inner-width);
    margin: 0 auto 2em;
  }

  .timeline-header h2 {
    margin: 0;
  }

  /* -----------------------------
     TIMELINE
  ----------------------------- */

  .timeline-viewport {
    width: 100%;
    overflow: hidden;
  }

  .timeline-track {
    display: flex;
    align-items: stretch;

    gap: 1.5em;

    width: max-content;

    padding-left: max(calc((100vw - var(--inner-width)) / 2), 20px);

    padding-right: max(calc((100vw - var(--inner-width)) / 2), 20px);

    will-change: transform;
  }

  /* -----------------------------
     CARD
  ----------------------------- */

  .timeline-card {
    flex: 0 0 min(600px, 70vw);

    display: flex;
    flex-direction: column;

    overflow: hidden;

    border-radius: 10px;

    background: var(--off-white);
  }

  .timeline-card__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .timeline-card__image img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .timeline-card__content {
    padding: 2em;

    display: flex;
    flex-direction: column;

    gap: 1em;
  }

  .timeline-card__heading {
    margin: 0;
  }

  .timeline-card__text {
    margin: 0;
  }

  .timeline-card__text > *:first-child {
    margin-top: 0;
  }

  .timeline-card__text > *:last-child {
    margin-bottom: 0;
  }

  /* -----------------------------
     MOBILE
  ----------------------------- */

  @media screen and (max-width: 749px) {
    .timeline-pin {
      min-height: 100svh;
    }

    .timeline-header {
      width: calc(100% - 40px);
    }

    .timeline-track {
      gap: 1em;

      padding-left: 20px;
      padding-right: 20px;
    }

    .timeline-card {
      flex-basis: 85vw;
    }

    .timeline-card__content {
      padding: 1.5em;
    }
  }
{% endstylesheet %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('#SideScrollTimeline-{{ section.id }}');

    if (!section) return;

    const pin = section.querySelector('.timeline-pin');
    const track = section.querySelector('.timeline-track');

    if (!pin || !track) return;

    gsap.registerPlugin(ScrollTrigger);

    let timelineTween;

    function createTimeline() {
      if (timelineTween) {
        timelineTween.scrollTrigger.kill();
        timelineTween.kill();
      }

      gsap.set(track, {
        x: 0,
      });

      const scrollDistance = track.scrollWidth - window.innerWidth;

      /*
       * If there isn't enough content to actually
       * scroll horizontally, don't create the animation.
       */
      if (scrollDistance <= 0) return;

      timelineTween = gsap.to(track, {
        x: -scrollDistance,

        ease: 'none',

        scrollTrigger: {
          trigger: section,

          start: 'top top',

          end: () => `+=${scrollDistance}`,

          pin: pin,

          scrub: 1,

          invalidateOnRefresh: true,

          anticipatePin: 1,
        },
      });
    }

    createTimeline();

    window.addEventListener('load', () => {
      ScrollTrigger.refresh();
    });
  });
</script>

{% schema %}
{
  "name": "Side Scroll Timeline",
  "tag": "section",
  "class": "side-scroll-timeline-section",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Our Story"
    }
  ],

  "blocks": [
    {
      "type": "timeline_item",
      "name": "Timeline Item",

      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Timeline heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Tell your story here.</p>"
        }
      ]
    }
  ],

  "max_blocks": 25,

  "presets": [
    {
      "name": "Side Scroll Timeline",
      "blocks": [
        {
          "type": "timeline_item"
        },
        {
          "type": "timeline_item"
        },
        {
          "type": "timeline_item"
        },
        {
          "type": "timeline_item"
        }
      ]
    }
  ]
}
{% endschema %}

{% liquid
  assign header_menu = linklists[section.settings.menu]
  assign logo_width_2x = section.settings.logo_width | times: 2
%}

{{ 'variables.css' | asset_url | stylesheet_tag }}

<header
  id="MegaHeader-{{ section.id }}"
  class="mega-header"
  data-mega-header
  style="
    --header-background: {{ section.settings.background_color }};
    --header-text: {{ section.settings.text_color }};
    --header-border: {{ section.settings.border_color }};
    --mega-background: {{ section.settings.mega_menu_background }};
    --mega-text: {{ section.settings.mega_menu_text }};
    --logo-width: {{ section.settings.logo_width }}px;
  "
>
  {%- comment -%}
    TOP HEADER ROW
  {%- endcomment -%}

  <div class="mega-header__utility">
    <div class="mega-header__container mega-header__utility-container">
      <div class="mega-header__utility-items">
        {% if section.settings.wholesale_text != blank %}
          <a
            class="mega-header__utility-link mega-header__wholesale"
            href="{{ section.settings.wholesale_url | default: routes.account_login_url }}"
          >
            {{ section.settings.wholesale_text | escape }}
          </a>
        {% endif %}

        <div class="mega-header__search-wrapper" data-header-search>
          <form
            class="mega-header__search-form"
            action="{{ routes.search_url }}"
            method="get"
            role="search"
          >
            <label
              class="visually-hidden"
              for="HeaderSearchInput-{{ section.id }}"
            >
              Search
            </label>

            <input
              id="HeaderSearchInput-{{ section.id }}"
              class="mega-header__search-input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ section.settings.search_placeholder | escape }}"
              autocomplete="off"
            >

            <input type="hidden" name="options[prefix]" value="last">

            <button
              class="mega-header__search-submit"
              type="submit"
              aria-label="Submit search"
            >
              <svg
                aria-hidden="true"
                focusable="false"
                viewBox="0 0 24 24"
                width="20"
                height="20"
              >
                <path
                  d="m21 21-4.35-4.35m2.35-5.15A7.5 7.5 0 1 1 4 11.5a7.5 7.5 0 0 1 15 0Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
              </svg>
            </button>
          </form>

          <button
            class="mega-header__search-toggle"
            type="button"
            aria-label="Open search"
            aria-expanded="false"
            aria-controls="HeaderSearchInput-{{ section.id }}"
            data-search-toggle
          >
            <span class="mega-header__search-open-icon">
              <svg
                aria-hidden="true"
                focusable="false"
                viewBox="0 0 24 24"
                width="21"
                height="21"
              >
                <path
                  d="m21 21-4.35-4.35m2.35-5.15A7.5 7.5 0 1 1 4 11.5a7.5 7.5 0 0 1 15 0Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
              </svg>
            </span>

            <span class="mega-header__search-close-icon">
              <svg
                aria-hidden="true"
                focusable="false"
                viewBox="0 0 24 24"
                width="21"
                height="21"
              >
                <path
                  d="M6 6l12 12M18 6 6 18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
              </svg>
            </span>
          </button>
        </div>

        {% if shop.customer_accounts_enabled %}
          <a
            class="mega-header__icon-link"
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            aria-label="{% if customer %}View account{% else %}Log in to account{% endif %}"
          >
            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 24 24"
              width="22"
              height="22"
            >
              <circle
                cx="12"
                cy="8"
                r="4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
              />
              <path
                d="M4.5 21c.7-4.2 3.2-6.5 7.5-6.5s6.8 2.3 7.5 6.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              />
            </svg>

            {% if section.settings.show_icon_labels %}
              <span>
                {% if customer %}
                  Account
                {% else %}
                  Login
                {% endif %}
              </span>
            {% endif %}
          </a>
        {% endif %}

        <a
          class="mega-header__icon-link mega-header__cart-link"
          href="{{ routes.cart_url }}"
          aria-label="View cart with {{ cart.item_count }} items"
        >
          <span class="mega-header__cart-icon">
            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 24 24"
              width="23"
              height="23"
            >
              <path
                d="M3 4h2l2.1 10.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L20.5 7H6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <circle cx="9.5" cy="20" r="1.2" fill="currentColor"/>
              <circle cx="17" cy="20" r="1.2" fill="currentColor"/>
            </svg>

            <span
              class="mega-header__cart-count"
              data-cart-count
              {% if cart.item_count == 0 %}
                hidden
              {% endif %}
            >
              {{ cart.item_count }}
            </span>

            {% comment %}
              {% if cart.item_count > 0 %}
                <span class="mega-header__cart-count">
                  {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcomment %}
          </span>

          {% if section.settings.show_icon_labels %}
            <span>Cart</span>
          {% endif %}
        </a>
      </div>
    </div>
  </div>

  {%- comment -%}
    BOTTOM HEADER ROW
  {%- endcomment -%}

  <div class="mega-header__main">
    <div class="mega-header__container mega-header__main-container">
      <a
        class="mega-header__logo-link"
        href="{{ routes.root_url }}"
        aria-label="{{ shop.name | escape }} home"
      >
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: logo_width_2x
            | image_tag:
              class: 'mega-header__logo-image',
              widths: '100, 150, 200, 250, 300, 400, 500',
              loading: 'eager',
              alt: section.settings.logo.alt
          }}
        {% else %}
          <span class="mega-header__shop-name">
            {{ shop.name }}
          </span>
        {% endif %}
      </a>

      <nav
        class="mega-header__desktop-navigation"
        aria-label="Main navigation"
      >
        {% if header_menu != blank and header_menu.links.size > 0 %}
          <ul class="mega-header__menu-list" role="list">
            {% for link in header_menu.links %}
              <li
                class="
                  mega-header__menu-item
                  {% if link.links != blank %}mega-header__menu-item--has-children{% endif %}
                "
                {% if link.links != blank %}
                  data-mega-menu-item
                {% endif %}
              >
                <div class="mega-header__top-link-wrapper">
                  <a
                    class="
                      mega-header__top-link
                      {% if link.current or link.child_active %}is-active{% endif %}
                    "
                    href="{{ link.url }}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span>{{ link.title | escape }}</span>

                    {% if link.links != blank %}
                      <svg
                        class="mega-header__caret"
                        aria-hidden="true"
                        focusable="false"
                        viewBox="0 0 12 8"
                        width="11"
                        height="7"
                      >
                        <path
                          d="m1 1 5 5 5-5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    {% endif %}
                  </a>

                  {% if link.links != blank %}
                    <button
                      type="button"
                      class="mega-header__desktop-submenu-toggle"
                      aria-expanded="false"
                      aria-label="Open {{ link.title | escape }} menu"
                      data-desktop-submenu-toggle
                    >
                      <span class="visually-hidden"> Open {{ link.title | escape }} menu </span>
                    </button>
                  {% endif %}
                </div>

                {% if link.links != blank %}
                  <div
                    class="mega-header__mega-menu"
                    data-mega-menu
                  >
                    <div class="mega-header__mega-container">
                      <div class="mega-header__mega-heading">
                        <a href="{{ link.url }}">
                          {{ link.title | escape }}
                        </a>
                      </div>

                      <div class="mega-header__mega-columns">
                        {% for child_link in link.links %}
                          <div class="mega-header__mega-column">
                            <a
                              class="mega-header__child-heading"
                              href="{{ child_link.url }}"
                            >
                              {{ child_link.title | escape }}
                            </a>

                            {% if child_link.links != blank %}
                              <ul
                                class="mega-header__grandchild-list"
                                role="list"
                              >
                                {% for grandchild_link in child_link.links %}
                                  <li>
                                    <a
                                      class="mega-header__grandchild-link"
                                      href="{{ grandchild_link.url }}"
                                    >
                                      {{ grandchild_link.title | escape }}
                                    </a>
                                  </li>
                                {% endfor %}
                              </ul>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </nav>

      <button
        class="mega-header__mobile-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="MobileMenu-{{ section.id }}"
        data-mobile-menu-toggle
      >
        <span class="mega-header__mobile-open-icon">
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 24 24"
            width="26"
            height="26"
          >
            <path
              d="M3 6h18M3 12h18M3 18h18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            />
          </svg>
        </span>

        <span class="mega-header__mobile-close-icon">
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 24 24"
            width="26"
            height="26"
          >
            <path
              d="M6 6l12 12M18 6 6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            />
          </svg>
        </span>
      </button>
    </div>
  </div>

  {%- comment -%}
    MOBILE NAVIGATION
  {%- endcomment -%}

  <div
    id="MobileMenu-{{ section.id }}"
    class="mega-header__mobile-menu"
    data-mobile-menu
    aria-hidden="true"
  >
    <div class="mega-header__mobile-menu-inner">
      {% if header_menu != blank and header_menu.links.size > 0 %}
        <ul class="mega-header__mobile-list" role="list">
          {% for link in header_menu.links %}
            <li class="mega-header__mobile-item">
              <div class="mega-header__mobile-link-row">
                <a
                  class="mega-header__mobile-link"
                  href="{{ link.url }}"
                >
                  {{ link.title | escape }}
                </a>

                {% if link.links != blank %}
                  <button
                    class="mega-header__mobile-submenu-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-label="Open {{ link.title | escape }} submenu"
                    data-mobile-submenu-toggle
                  >
                    <svg
                      aria-hidden="true"
                      focusable="false"
                      viewBox="0 0 12 8"
                      width="12"
                      height="8"
                    >
                      <path
                        d="m1 1 5 5 5-5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                {% endif %}
              </div>

              {% if link.links != blank %}
                <div
                  class="mega-header__mobile-submenu"
                  data-mobile-submenu
                >
                  <ul role="list">
                    {% for child_link in link.links %}
                      <li>
                        <div class="mega-header__mobile-child-row">
                          <a
                            class="mega-header__mobile-child-link"
                            href="{{ child_link.url }}"
                          >
                            {{ child_link.title | escape }}
                          </a>

                          {% if child_link.links != blank %}
                            <button
                              class="mega-header__mobile-child-toggle"
                              type="button"
                              aria-expanded="false"
                              aria-label="Open {{ child_link.title | escape }} submenu"
                              data-mobile-child-toggle
                            >
                              <svg
                                aria-hidden="true"
                                focusable="false"
                                viewBox="0 0 12 8"
                                width="11"
                                height="7"
                              >
                                <path
                                  d="m1 1 5 5 5-5"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.5"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            </button>
                          {% endif %}
                        </div>

                        {% if child_link.links != blank %}
                          <div
                            class="mega-header__mobile-grandchildren"
                            data-mobile-grandchildren
                          >
                            <ul role="list">
                              {% for grandchild_link in child_link.links %}
                                <li>
                                  <a href="{{ grandchild_link.url }}">
                                    {{ grandchild_link.title | escape }}
                                  </a>
                                </li>
                              {% endfor %}
                            </ul>
                          </div>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      <div class="mega-header__mobile-utility">
        {% if section.settings.wholesale_text != blank %}
          <a
            href="{{ section.settings.wholesale_url | default: routes.account_login_url }}"
          >
            {{ section.settings.wholesale_text | escape }}
          </a>
        {% endif %}

        {% if shop.customer_accounts_enabled %}
          <a
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          >
            {% if customer %}
              My account
            {% else %}
              Customer login
            {% endif %}
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}">
          Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
        </a>
      </div>
    </div>
  </div>
</header>

{% style %}
    .custom-mega-header-section {
      position: relative !important;
      display: block !important;
      width: 100% !important;
      height: auto !important;
    }

   #shopify-section-{{ section.id }} {
    position: sticky !important;
    top: 0;
    left: auto;
    display: block !important;
    width: 100% !important;
    height: auto !important;
    z-index: 1000;
    background: #f8f9f6;
  }

    #MegaHeader-{{ section.id }} {
      position: relative;
      display: block !important;
      width: 100% !important;
      height: auto !important;
      flex-direction: initial !important;
      align-items: initial !important;
      justify-content: initial !important;
    }
        #MegaHeader-{{ section.id }} .mega-header__utility,
        #MegaHeader-{{ section.id }} .mega-header__main {
          display: block !important;
          width: 100% !important;
          clear: both;
        }

        #MegaHeader-{{ section.id }} .mega-header__utility-container {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: flex-end !important;
        width: 100% !important;
      }

      #MegaHeader-{{ section.id }} .mega-header__main-container {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        width: 100% !important;
      }

          #MegaHeader-{{ section.id }} *,
          #MegaHeader-{{ section.id }} *::before,
          #MegaHeader-{{ section.id }} *::after {
            box-sizing: border-box;
          }

          #MegaHeader-{{ section.id }} {
            position: relative;
            width: 100%;
            background: var(--header-background);
            color: var(--header-text);
          }

          #MegaHeader-{{ section.id }} a {
            color: inherit;
            text-decoration: none;
          }

          #MegaHeader-{{ section.id }} button,
          #MegaHeader-{{ section.id }} input {
            font: inherit;
          }

          #MegaHeader-{{ section.id }} button {
            color: inherit;
          }

          #MegaHeader-{{ section.id }} .visually-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            padding: 0 !important;
            margin: -1px !important;
            overflow: hidden !important;
            clip: rect(0, 0, 0, 0) !important;
            white-space: nowrap !important;
            border: 0 !important;
          }

          #MegaHeader-{{ section.id }} .mega-header__container {
            width: min(100%, {{ section.settings.max_width }}px);
            margin: 0 auto;
            padding-right: 7.5%;
            padding-left: 7.5%;
          }

          /*
           * Utility row
           */

         #MegaHeader-{{ section.id }} .mega-header__utility {
          min-height: 46px;
          max-height: 60px;
          overflow: hidden;
          opacity: 1;
          border-bottom: 1px solid var(--header-border);
          transition:
            max-height 250ms ease,
            min-height 250ms ease,
            opacity 150ms ease;
        }

        #MegaHeader-{{ section.id }}.utility-hidden .mega-header__utility {
          min-height: 0;
          max-height: 0;
          opacity: 0;
          border-bottom-width: 0;
          pointer-events: none;
        }

          #MegaHeader-{{ section.id }} .mega-header__utility-container {
            min-height: 46px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
          }

          #MegaHeader-{{ section.id }} .mega-header__utility-items {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 22px;
          }

          #MegaHeader-{{ section.id }} .mega-header__utility-link,
          #MegaHeader-{{ section.id }} .mega-header__icon-link {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 44px;
            font-size: 13px;
            line-height: 1.2;
            white-space: nowrap;
          }

          #MegaHeader-{{ section.id }} .mega-header__wholesale {
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.07em;
          }

          #MegaHeader-{{ section.id }} .mega-header__utility-link:hover,
          #MegaHeader-{{ section.id }} .mega-header__icon-link:hover {
            opacity: 0.7;
          }

          /*
           * Expanding desktop search
           */

          #MegaHeader-{{ section.id }} .mega-header__search-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            height: 40px;
          }

          #MegaHeader-{{ section.id }} .mega-header__search-form {
            position: absolute;
            top: 50%;
            right: 34px;
            width: 0;
            height: 38px;
            opacity: 0;
            overflow: hidden;
            pointer-events: none;
            transform: translateY(-50%);
            transition:
              width 300ms ease,
              opacity 180ms ease;
          }

          #MegaHeader-{{ section.id }}
            .mega-header__search-wrapper.is-open
            .mega-header__search-form {
            width: min(320px, 30vw);
            opacity: 1;
            pointer-events: auto;
          }

          #MegaHeader-{{ section.id }} .mega-header__search-input {
            width: 100%;
            height: 38px;
            padding: 7px 42px 7px 14px;
            color: var(--header-text);
            background: var(--header-background);
            border: 1px solid var(--header-border);
            border-radius: 0;
            outline: none;
          }

          #MegaHeader-{{ section.id }} .mega-header__search-input:focus {
            border-color: currentColor;
          }

          #MegaHeader-{{ section.id }} .mega-header__search-submit {
            position: absolute;
            top: 0;
            right: 0;
            width: 40px;
            height: 38px;
            display: grid;
            place-items: center;
            padding: 0;
            background: transparent;
            border: 0;
            cursor: pointer;
          }

          #MegaHeader-{{ section.id }} .mega-header__search-toggle {
            position: relative;
            z-index: 2;
            width: 34px;
            height: 40px;
            display: grid;
            place-items: center;
            padding: 0;
            background: var(--header-background);
            border: 0;
            cursor: pointer;
            /* border:1px solid var(--black);
            border-radius:10px;
            padding:0 10px; */
          }

          #MegaHeader-{{ section.id }} .mega-header__search-close-icon {
            display: none;
          }

          #MegaHeader-{{ section.id }}
            .mega-header__search-wrapper.is-open
            .mega-header__search-open-icon {
            display: none;
          }

          #MegaHeader-{{ section.id }}
            .mega-header__search-wrapper.is-open
            .mega-header__search-close-icon {
            display: block;
          }

          /*
           * Cart count
           */

          #MegaHeader-{{ section.id }} .mega-header__cart-icon {
            position: relative;
            display: inline-flex;
          }

          #MegaHeader-{{ section.id }} .mega-header__cart-count {
            position: absolute;
            top: -8px;
            right: -10px;
            min-width: 18px;
            height: 18px;
            display: grid;
            place-items: center;
            padding: 0 4px;
            color: var(--header-background);
            background: var(--header-text);
            border-radius: 999px;
            font-size: 10px;
            font-weight: 700;
            line-height: 1;
          }

          /*
           * Main navigation row
           */

          #MegaHeader-{{ section.id }} .mega-header__main {
            position: relative;
            min-height: {{ section.settings.main_row_height }}px;
            border-bottom: 1px solid var(--header-border);
          }

          #MegaHeader-{{ section.id }} .mega-header__main-container {
            min-height: {{ section.settings.main_row_height }}px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
          }

          #MegaHeader-{{ section.id }} .mega-header__logo-link {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            max-width: var(--logo-width);
          }

          #MegaHeader-{{ section.id }} .mega-header__logo-image {
            display: block;
            width: var(--logo-width);
            max-width: 100%;
            height: auto;
          }

          #MegaHeader-{{ section.id }} .mega-header__shop-name {
            font-size: 24px;
            font-weight: 700;
            line-height: 1;
          }

          #MegaHeader-{{ section.id }} .mega-header__desktop-navigation {
            align-self: stretch;
            display: flex;
            justify-content: flex-end;
          }

          #MegaHeader-{{ section.id }} .mega-header__menu-list {
            display: flex;
            align-items: stretch;
            justify-content: flex-end;
            gap: {{ section.settings.menu_spacing }}px;
            margin: 0;
            padding: 0;
            list-style: none;
          }

          #MegaHeader-{{ section.id }} .mega-header__menu-item {
            position: static;
            display: flex;
            align-items: stretch;
          }

          #MegaHeader-{{ section.id }} .mega-header__top-link-wrapper {
            position: relative;
            display: flex;
            align-items: stretch;
          }

          #MegaHeader-{{ section.id }} .mega-header__top-link {
            position: relative;
            display: flex;

<script>
  (() => {
    const header = document.getElementById('MegaHeader-{{ section.id }}');
    const headerSection = document.getElementById('shopify-section-{{ section.id }}');

    if (!header || !headerSection || header.dataset.initialized === 'true') {
      return;
    }

    header.dataset.initialized = 'true';

    const searchWrapper = header.querySelector('[data-header-search]');
    const searchToggle = header.querySelector('[data-search-toggle]');
    const searchInput = header.querySelector('#HeaderSearchInput-{{ section.id }}');

    const mobileToggle = header.querySelector('[data-mobile-menu-toggle]');
    const mobileMenu = header.querySelector('[data-mobile-menu]');

    function closeSearch() {
      if (!searchWrapper || !searchToggle) return;

      searchWrapper.classList.remove('is-open');
      searchToggle.setAttribute('aria-expanded', 'false');
      searchToggle.setAttribute('aria-label', 'Open search');
    }

    function closeDesktopMegaMenus(exceptItem = null) {
      header.querySelectorAll('[data-mega-menu-item]').forEach((item) => {
        if (item === exceptItem) return;

        item.classList.remove('is-open');

        const toggle = item.querySelector('[data-desktop-submenu-toggle]');

        if (toggle) {
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    function closeMobileMenu() {
      if (!mobileToggle || !mobileMenu) return;

      mobileToggle.classList.remove('is-open');
      mobileMenu.classList.remove('is-open');

      mobileToggle.setAttribute('aria-expanded', 'false');
      mobileToggle.setAttribute('aria-label', 'Open menu');
      mobileMenu.setAttribute('aria-hidden', 'true');

      document.body.classList.remove('mega-header-menu-open');
    }

    if (searchToggle && searchWrapper) {
      searchToggle.addEventListener('click', () => {
        const opening = !searchWrapper.classList.contains('is-open');

        searchWrapper.classList.toggle('is-open', opening);
        searchToggle.setAttribute('aria-expanded', String(opening));
        searchToggle.setAttribute('aria-label', opening ? 'Close search' : 'Open search');

        header.classList.remove('utility-hidden');

        if (opening) {
          closeDesktopMegaMenus();
          closeMobileMenu();

          window.setTimeout(() => {
            searchInput?.focus();
          }, 310);
        }
      });
    }

    header.querySelectorAll('[data-mega-menu-item]').forEach((item) => {
      const toggle = item.querySelector('[data-desktop-submenu-toggle]');

      if (!toggle) return;

      toggle.addEventListener('click', (event) => {
        event.preventDefault();

        const opening = !item.classList.contains('is-open');

        closeDesktopMegaMenus(item);
        closeSearch();

        item.classList.toggle('is-open', opening);
        toggle.setAttribute('aria-expanded', String(opening));

        header.classList.remove('utility-hidden');
      });

      item.addEventListener('mouseenter', () => {
        closeDesktopMegaMenus(item);
        header.classList.remove('utility-hidden');
      });
    });

    if (mobileToggle && mobileMenu) {
      mobileToggle.addEventListener('click', () => {
        const opening = !mobileMenu.classList.contains('is-open');

        mobileToggle.classList.toggle('is-open', opening);
        mobileMenu.classList.toggle('is-open', opening);

        mobileToggle.setAttribute('aria-expanded', String(opening));
        mobileToggle.setAttribute('aria-label', opening ? 'Close menu' : 'Open menu');
        mobileMenu.setAttribute('aria-hidden', String(!opening));

        document.body.classList.toggle('mega-header-menu-open', opening);

        headerSection.classList.remove('header-hidden');

        if (opening) {
          closeSearch();
          closeDesktopMegaMenus();
        }
      });
    }

    header.querySelectorAll('[data-mobile-submenu-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const submenu = toggle.closest('.mega-header__mobile-item')?.querySelector('[data-mobile-submenu]');

        if (!submenu) return;

        const opening = !submenu.classList.contains('is-open');

        submenu.classList.toggle('is-open', opening);
        toggle.setAttribute('aria-expanded', String(opening));
      });
    });

    header.querySelectorAll('[data-mobile-child-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const submenu = toggle.closest('li')?.querySelector('[data-mobile-grandchildren]');

        if (!submenu) return;

        const opening = !submenu.classList.contains('is-open');

        submenu.classList.toggle('is-open', opening);
        toggle.setAttribute('aria-expanded', String(opening));
      });
    });

    document.addEventListener('click', (event) => {
      if (header.contains(event.target)) return;

      closeSearch();
      closeDesktopMegaMenus();
      closeMobileMenu();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      closeSearch();
      closeDesktopMegaMenus();
      closeMobileMenu();
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 989) {
        closeMobileMenu();
      } else {
        closeDesktopMegaMenus();
      }
    });

    /*
     * Hide only the utility row when scrolling down.
     * Show it again when scrolling up.
     *
     * Uses a scroll anchor so the utility row collapsing does not
     * accidentally trigger the opposite scroll direction.
     */

    let scrollAnchor = Math.max(window.pageYOffset || document.documentElement.scrollTop, 0);

    let ticking = false;
    let utilityHidden = header.classList.contains('utility-hidden');

    const scrollDistance = 30;
    const utilityHidePoint = 100;

    let userScrollTimeout = null;
    let userIsScrolling = false;

    function markUserScrolling() {
      userIsScrolling = true;

      clearTimeout(userScrollTimeout);

      userScrollTimeout = setTimeout(() => {
        userIsScrolling = false;
      }, 150);
    }

    /*
     * Real user scroll inputs.
     */
    window.addEventListener('wheel', markUserScrolling, {
      passive: true,
    });

    window.addEventListener('touchmove', markUserScrolling, {
      passive: true,
    });

    /*
     * Keyboard scrolling.
     */
    window.addEventListener('keydown', (event) => {
      const scrollKeys = ['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '];

      if (scrollKeys.includes(event.key)) {
        markUserScrolling();
      }
    });

    function updateStickyHeader() {
      const currentScroll = Math.max(window.pageYOffset || document.documentElement.scrollTop, 0);

      /*
       * Ignore scroll-position changes caused by DOM/layout changes
       * rather than actual user scrolling.
       *
       * This prevents things such as "Load More" from triggering
       * the header animation.
       */
      if (!userIsScrolling) {
        scrollAnchor = currentScroll;
        ticking = false;
        return;
      }

      /*
       * Always show the utility row near the top of the page.
       */
      if (currentScroll <= 20) {
        header.classList.remove('utility-hidden');
        utilityHidden = false;
        scrollAnchor = currentScroll;
        ticking = false;
        return;
      }

      /*
       * Keep it visible while the visitor is interacting
       * with the header.
       */
      const searchIsOpen = searchWrapper?.classList.contains('is-open');

      const mobileMenuIsOpen = mobileMenu?.classList.contains('is-open');

      const megaMenuIsOpen = Boolean(header.querySelector('[data-mega-menu-item].is-open'));

      if (searchIsOpen || mobileMenuIsOpen || megaMenuIsOpen) {
        header.classList.remove('utility-hidden');
        utilityHidden = false;
        scrollAnchor = currentScroll;
        ticking = false;
        return;
      }

      const distanceFromAnchor = currentScroll - scrollAnchor;

      /*
       * Scrolling down.
       */
      if (!utilityHidden && distanceFromAnchor >= scrollDistance && currentScroll > utilityHidePoint) {
        header.classList.add('utility-hidden');
        utilityHidden = true;

        /*
         * Reset the anchor immediately after changing the
         * utility row height. This prevents the height change
         * from being interpreted as upward scrolling.
         */
        scrollAnchor = currentScroll;
      } else if (utilityHidden && distanceFromAnchor <= -scrollDistance) {
        /*
         * Scrolling up.
         */
        header.classList.remove('utility-hidden');
        utilityHidden = false;

        scrollAnchor = currentScroll;
      } else if (Math.abs(distanceFromAnchor) >= 60) {
        /*
         * Keep the anchor reasonably close to the current
         * scroll position without reacting to tiny movements.
         */
        scrollAnchor = currentScroll;
      }

      ticking = false;
    }

    function handleScroll() {
      if (ticking) return;

      ticking = true;

      window.requestAnimationFrame(updateStickyHeader);
    }

    window.addEventListener('scroll', handleScroll, {
      passive: true,
    });
  })();

  window.updateCartCount = function (cart) {
    if (!cart) return;

    const cartCountElements = document.querySelectorAll('[data-cart-count]');

    cartCountElements.forEach((element) => {
      element.textContent = cart.item_count;

      if (cart.item_count > 0) {
        element.hidden = false;
      } else {
        element.hidden = true;
      }
    });
  };
</script>


{{ 'variables.css' | asset_url | stylesheet_tag }}

<section class="main-page-container full-width">
  <div class="main-page-wrapper">
    <header class="main-page-header">
      <h1>{{ page.title }}</h1>
    </header>

    {% if page.content != blank %}
      <div class="main-page-content rte">
        {{ page.content }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .main-page-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .main-page-wrapper {
    width: var(--inner-width);
    margin: 0 auto;
    padding: 60px 0;
  }

  .main-page-header {
    margin-bottom: 30px;
  }

  .main-page-header h1 {
    margin: 0;
  }

  .main-page-content {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .main-page-wrapper {
      width: 90%;
      padding: 40px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Main Page",
  "settings": [],
  "presets": [
    {
      "name": "Main Page"
    }
  ]
}
{% endschema %}

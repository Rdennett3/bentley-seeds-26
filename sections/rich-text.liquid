<section
  id="RichText-{{ section.id }}"
  class="rich-text"
>
  <div class="rich-text__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="rich-text__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="rich-text__content rte">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a
        href="{{ section.settings.button_link }}"
        class="rich-text__button"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .rich-text {
    width: 100%;
  }

  .rich-text__inner {
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .rich-text__heading {
    margin: 0 0 20px;
  }

  .rich-text__content {
    margin: 0;
  }

  .rich-text__content > *:first-child {
    margin-top: 0;
  }

  .rich-text__content > *:last-child {
    margin-bottom: 0;
  }

  .rich-text__button {
    display: inline-block;
    margin-top: 25px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}

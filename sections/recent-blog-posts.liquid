{{ 'variables.css' | asset_url | stylesheet_tag }}

{% liquid
  assign selected_blog = section.settings.blog
%}

<section class="recent-blog section-{{ section.id }}">
  <div class="recent-blog__wrapper">
    {% if section.settings.heading != blank %}
      <div class="recent-blog__header">
        <h2 class="recent-blog__heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    {% if selected_blog != blank %}
      <div class="recent-blog__grid">
        {% for article in selected_blog.articles limit: 4 %}
          <a
            href="{{ article.url }}"
            class="recent-blog__card"
          >
            <div class="recent-blog__image">
              {% if article.image %}
                {{
                  article.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', widths: '300, 400, 600, 800', alt: article.image.alt
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'recent-blog__placeholder' }}
              {% endif %}
            </div>

            <div class="recent-blog__info">
              <h3 class="recent-blog__title">
                {{ article.title }}
              </h3>

              <span class="recent-blog__button">
                {{ section.settings.button_text }}
              </span>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <p>Please select a blog in the section settings.</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .recent-blog {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .recent-blog__wrapper {
    width: var(--inner-width);
  }

  .recent-blog__header {
    margin-bottom: 2em;
  }

  .recent-blog__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5em;
  }

  .recent-blog__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .recent-blog__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .recent-blog__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .recent-blog__placeholder {
    width: 100%;
    height: 100%;
  }

  .recent-blog__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-grow: 1;
    padding: 1em 0;
  }

  .recent-blog__title {
    margin: 0 0 1em;
  }

  .recent-blog__button {
    display: inline-block;
    margin-top: auto;
  }

  @media screen and (max-width: 749px) {
    .recent-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recent Blog Posts",
  "tag": "section",
  "class": "recent-blog-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest from the Blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Read more text",
      "default": "Read More"
    }
  ],
  "presets": [
    {
      "name": "Recent Blog Posts"
    }
  ]
}
{% endschema %}

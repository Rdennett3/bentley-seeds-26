{% liquid

%}

{{ 'variables.css' | asset_url | stylesheet_tag }}

{% style %}
      .section-{{ section.id }} {
        /* display:none; */
      }
      .expandable-container {
        width:100%;
        height:auto;
        background:var(--off-white);
        display:flex;
        align-items:center;
        justify-content: center;
      }

      .expandable-wrapper {
        width:var(--inner-width);
        max-width:var(--max-width);
        background:var(--off-white);
        display:flex;
        flex-direction:column;
      }

      .expandable-section:nth-of-type(1) {
        display:flex;
        align-items:flex-start;
        justify-content:flex-start;
        padding:2.5% 0;
      }

      .expandable-section:nth-of-type(1) h2 {
        font-size:3em;
      }

      .expandable-section:nth-of-type(2) {
      display: flex;
      gap: .5em;
      width: 100%;
      overflow: hidden;
    }

    .expandable-item {
      flex: 1 1 0;
      min-width: 0;
      border:1px solid black;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      border-radius: var(--radius);
      transition: flex-grow 0.5s ease;
      margin-bottom:3em;
      min-height:50vh;
      display:flex;
      align-items:center;
      justify-content:center;
      /* background-image:url('https://cdn.shopify.com/s/files/1/0562/4205/files/vegetables-new.png?v=1788444801');
      background-size:cover;
      background-position:center; */
    }

    .expandable-item:nth-of-type(1){
      background:orange;
    }

    .expandable-item:nth-of-type(2) {
      background:yellowgreen;
    }
    .expandable-item:nth-of-type(3) {
      background:red;
    }
    /* Grow the hovered item */
    .expandable-section:nth-of-type(2):hover .expandable-item {
      flex-grow: 0.7;
    }

    .expandable-section:nth-of-type(2) .expandable-item:hover {
      flex-grow: 1.15;
    }

    .expandable-item__image {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.6s ease;
  }

  .expandable-item:hover .expandable-item__image {
    transform: scale(1.05);
  }

  .expandable-item__overlay {
    position: absolute;
    inset: 0;

    background: rgba(0, 0, 0, 0.25);

    z-index: 1;
  }

  .expandable-item__content {
    position: relative;
    z-index: 2;

    padding: 2rem;

    color: white;
  }

  .expandable-item__content h3 {
    font-size: 1.5rem;
    margin: 0;
  }
{% endstyle %}

<section class="section-{{ section.id }} full-width">
  <div class="expandable-container">
    <div class="expandable-wrapper">
      <div class="expandable-section">
        <h2><strong>Shop</strong> Collections</h2>
      </div>
      <div class="expandable-section">
        {% for block in section.blocks %}
          {% assign collection = block.settings.collection %}

          {% if collection != blank %}
            <a
              href="{{ collection.url }}"
              class="expandable-item"
              {{ block.shopify_attributes }}
            >
              {% if collection.featured_image %}
                {{
                  collection.featured_image
                  | image_url: width: 1600
                  | image_tag: loading: 'lazy', class: 'expandable-item__image', alt: collection.title
                }}
              {% endif %}

              <div class="expandable-item__overlay"></div>

              <div class="expandable-item__content">
                <h3>{{ collection.title }}</h3>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% javascript %}
{% endjavascript %}

{% schema %}
{
  "name": "Expandable Collections",
  "tag": "section",
  "class": "shopify-section",
  "settings": [],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Expandable Collections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}

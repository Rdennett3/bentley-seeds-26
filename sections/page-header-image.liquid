<section class="page-header-image section-{{ section.id }}">
  {% if section.settings.image != blank %}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        loading: 'eager',
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        class: 'page-header-image__image'
    }}
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'page-header-image__placeholder' }}
  {% endif %}
</section>

{% style %}
  .section-{{ section.id }} {
    width: 100%;
    overflow: hidden;
  }

  .section-{{ section.id }} .page-header-image__image {
    display: block;
    width: 100%;
    height: {{ section.settings.desktop_height }}px;
    object-fit: cover;
    object-position: center;
  }

  .section-{{ section.id }} .page-header-image__placeholder {
    display: block;
    width: 100%;
    height: {{ section.settings.desktop_height }}px;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .page-header-image__image,
    .section-{{ section.id }} .page-header-image__placeholder {
      height: {{ section.settings.mobile_height }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Page header image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Header image"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 200,
      "max": 800,
      "step": 25,
      "unit": "px",
      "label": "Desktop height",
      "default": 450
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 150,
      "max": 600,
      "step": 25,
      "unit": "px",
      "label": "Mobile height",
      "default": 300
    }
  ],
  "presets": [
    {
      "name": "Page header image"
    }
  ]
}
{% endschema %}

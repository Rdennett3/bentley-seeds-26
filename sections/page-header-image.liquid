{{ 'variables.css' | asset_url | stylesheet_tag }}

<section class="page-header-image section-{{ section.id }} full-width">
  {% if section.settings.image != blank %}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        loading: 'eager',
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        class: 'page-header-image__image'
    }}
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'page-header-image__placeholder' }}
  {% endif %}

  <div class="page-header-image__overlay">
    <h1 class="page-header-image__title">
      {{ page.title }}
    </h1>
  </div>
</section>

{% style %}
    .section-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .section-{{ section.id }} .page-header-image__image {
    display: block;
    width: 100%;
    height: {{ section.settings.desktop_height }}px;
    object-fit: cover;
    object-position: center;
  }

  .section-{{ section.id }} .page-header-image__placeholder {
    display: block;
    width: 100%;
    height: {{ section.settings.desktop_height }}px;
  }

  /* Bottom overlay */
  .section-{{ section.id }} .page-header-image__overlay {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    /* background:rgba(244, 145, 43, .5); */
    /* background: linear-gradient(180deg,rgba(244, 145, 43, .15) 0%, rgba(244, 145, 43, .5) 50%, rgba(244, 145, 43, .8) 100%); */
    height:100%;
    display:flex;
    align-items:flex-end;
    justify-content:flex-start;
    padding:0 0 5% 5%;
    box-sizing: border-box;
  }

  /* Page title */
  .section-{{ section.id }} .page-header-image__title {
    margin: 0;
    color: var(--black);
    padding:15px 30px;
    border:1px solid var(--black);
    background:var(--off-white);
    border-radius:25px;
    font-size: 48px;
    line-height: 1.1;
  }

  @media screen and (max-width: 749px) {

    .section-{{ section.id }} .page-header-image__image,
    .section-{{ section.id }} .page-header-image__placeholder {
      height: {{ section.settings.mobile_height }}px;
    }

    .section-{{ section.id }} .page-header-image__overlay {
      padding: 18px 20px;
    }

    .section-{{ section.id }} .page-header-image__title {
      font-size: 32px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Page header image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Header image"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 200,
      "max": 800,
      "step": 25,
      "unit": "px",
      "label": "Desktop height",
      "default": 450
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 150,
      "max": 600,
      "step": 25,
      "unit": "px",
      "label": "Mobile height",
      "default": 300
    }
  ],
  "presets": [
    {
      "name": "Page header image"
    }
  ]
}
{% endschema %}

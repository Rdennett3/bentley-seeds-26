{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

{{ 'variables.css' | asset_url | stylesheet_tag }}

<div class="err-container full-width">
  <div class="err-section">
    <h1 class="err-header">{{ '404.title' | t }}</h1>
  </div>
  <div class="err-section marquee">
    <div class="marquee-track">
      <div class="marquee-group">
        <h2>Looks Like This Page Is Still <span class="growing">Growing</span></h2>
      </div>
    </div>
  </div>
  <div class="err-section full-width">
    <div class="lower-err-section">
      <a href="/" class="main-btn">Return To Homepage</a>
    </div>
    <div class="lower-err-section">
      <a href="/collections/sale" class="main-btn">See What's On Sale</a>
    </div>
  </div>
  <div class="err-section"></div>
</div>

{% comment %}
  <div class="err-wrapper">
    <div class="err-section">
      <h1>{{ '404.title' | t }}</h1>
      <h2>UH OH!</h2>
      <h3>Looks like this page is still growing!</h3>
    </div>
    <div class="err-section"></div>
  </div>
{% endcomment %}

{% comment %}
  <h1>{{ '404.title' | t }}</h1>

  <p>
    {{ '404.not_found' | t }}
  </p>

  <a href="{{ routes.all_products_collection_url }}">
    {{ '404.back_to_shopping' | t }}
     </a>
{% endcomment %}

{% stylesheet %}
  .err-container {
    width: 100%;
    height: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .err-section {
    width: 100%;
    height: auto;
  }

  .err-section:nth-of-type(1) {
    /* background: var(--black); */

    color: var(--black);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--black);
    padding: 5% 0;
  }

  .err-section:nth-of-type(2) {
    padding: 2.5% 0;
  }

  .marquee {
    overflow: hidden;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    width: var(--inner-width);
  }

  .marquee-group {
    display: flex;
    gap: 3rem;
    flex-shrink: 0;
    white-space: nowrap;
    padding-left: 3rem;
    /* margin-left: 5%; */
  }

  .err-section:nth-of-type(3) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1em;
    width: 90%;
    margin-bottom: 1em;
  }

  .lower-err-section {
    width: 100%;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    height: auto;
    padding: 10% 0;
    border: 1px solid var(--black);
    box-shadow: 5px 5px 0 var(--black);
    /* background: var(--orange); */
    border-radius: 10px;
  }

  .lower-err-section a {
    margin-top: 0 !important;
  }

  .err-section:nth-of-type(4) {
    height: 25px;
    background: var(--black);
  }

  .err-section h1 {
    font-size: clamp(5em, 15vw, 15em);
    background: var(--black);
    padding: 2% 15%;
    border-radius: 10px;
    color: var(--off-white);
  }

  .err-section h2 {
    font-size: clamp(2em, 6vw, 8em);
  }

  .err-section h3 {
    font-size: clamp(1.5em, 3vw, 3em);
  }

  .err-btn {
    padding: 10px 5%;
    background: var(--off-white);
    font-size: 1.5em;
  }
{% endstylesheet %}

{% javascript %}
  const marquee = document.querySelector('.marquee');
  const track = marquee.querySelector('.marquee-track');
  const group = marquee.querySelector('.marquee-group');

  // Clone automatically
  const clone = group.cloneNode(true);
  clone.setAttribute('aria-hidden', 'true');
  track.appendChild(clone);

  // Calculate speed based on width
  const pixelsPerSecond = 200;
  const distance = group.offsetWidth;
  const duration = distance / pixelsPerSecond;

  gsap.to(track, {
    x: -distance,
    duration: duration,
    ease: 'none',
    repeat: -1,
  });

  gsap.to('.err-header', {
    scale: 1.05,
    duration: 1.5,
    yoyo: true,
    repeat: -1,
  });

  gsap.from('.err-header', {
    yPercent: 40,
    opacity: 0,
    duration: 1.25,
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}

{% comment %}
  Dawn-inspired main product section for Shopify Skeleton theme.
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}

<section
  class="product-section product-section--{{ section.id }}"
  data-product-section
>
  <div class="product-page-width">
    <div class="product-layout">
      <!-- Product media -->
      <div class="product-media">
        {% if product.media.size > 0 %}
          <div class="product-gallery">
            <!-- Thumbnail column -->
            {% if product.media.size > 1 %}
              <div
                class="product-media__thumbnails"
                aria-label="Product media thumbnails"
              >
                {% for media in product.media %}
                  <button
                    type="button"
                    class="product-media__thumbnail{% if forloop.first %} is-active{% endif %}"
                    data-thumbnail-target="{{ media.id }}"
                    aria-label="View product media {{ forloop.index }}"
                  >
                    {{
                      media.preview_image
                      | image_url: width: 180
                      | image_tag:
                        loading: 'lazy',
                        widths: '90, 120, 180',
                        sizes: '90px',
                        class: 'product-media__thumbnail-image'
                    }}
                  </button>
                {% endfor %}
              </div>
            {% endif %}

            <!-- Selected large image -->
            <div class="product-media__main">
              {% for media in product.media %}
                <div
                  class="product-media__item{% if forloop.first %} is-active{% endif %}"
                  data-product-media="{{ media.id }}"
                >
                  {% case media.media_type %}
                    {% when 'image' %}
                      {{
                        media
                        | image_url: width: 1800
                        | image_tag:
                          loading: 'lazy',
                          widths: '550, 750, 1100, 1500, 1800',
                          sizes: '(min-width: 990px) 50vw, 100vw',
                          class: 'product-media__image'
                      }}

                    {% when 'video' %}
                      {{ media | video_tag: controls: true, class: 'product-media__video' }}

                    {% when 'external_video' %}
                      {{ media | external_video_tag: class: 'product-media__video' }}

                    {% when 'model' %}
                      {{
                        media
                        | model_viewer_tag: reveal: 'interaction', toggleable: true, class: 'product-media__model'
                      }}
                  {% endcase %}
                </div>
              {% endfor %}
            </div>
          </div>

        {% else %}
          <div class="product-media__placeholder">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <!-- Product information -->
      <div class="product-details">
        <div class="product-details__inner">
          {% if section.settings.show_vendor and product.vendor != blank %}
            <p class="product-vendor">
              {{ product.vendor }}
            </p>
          {% endif %}

          <h1 class="product-title">
            {{ product.title }}
          </h1>

          <div
            class="product-price"
            data-product-price
          >
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="product-price__sale">
                {{ current_variant.price | money }}
              </span>

              <s class="product-price__compare">
                {{ current_variant.compare_at_price | money }}
              </s>
            {% else %}
              <span class="product-price__regular">
                {{ current_variant.price | money }}
              </span>
            {% endif %}
          </div>

          {% if section.settings.show_tax_notice %}
            <p class="product-tax-notice">Taxes and shipping calculated at checkout.</p>
          {% endif %}

          {% assign product_form_id = 'ProductForm-' | append: section.id %}

          {% form 'product',
            product,
            id: product_form_id,
            class: 'product-form',
            novalidate: 'novalidate',
            data-product-form: ''
          %}
            {% unless product.has_only_default_variant %}
              <div class="product-options">
                {% for option in product.options_with_values %}
                  <fieldset class="product-option">
                    <legend class="product-option__label">
                      {{ option.name }}:
                      <span data-selected-option="{{ option.position }}">
                        {{ option.selected_value }}
                      </span>
                    </legend>

                    <div class="product-option__values">
                      {% for value in option.values %}
                        {% assign option_input_id = 'Option-'
                          | append: section.id
                          | append: '-'
                          | append: option.position
                          | append: '-'
                          | append: forloop.index
                        %}

                        <input
                          type="radio"
                          id="{{ option_input_id }}"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          data-option-position="{{ option.position }}"
                          {% if option.selected_value == value %}
                            checked
                          {% endif %}
                        >

                        <label for="{{ option_input_id }}">
                          {{ value }}
                        </label>
                      {% endfor %}
                    </div>
                  </fieldset>
                {% endfor %}
              </div>
            {% endunless %}

            <select
              name="id"
              class="product-variant-select"
              data-variant-select
              aria-label="Select product variant"
            >
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                  data-available="{{ variant.available }}"
                  data-option1="{{ variant.option1 | escape }}"
                  data-option2="{{ variant.option2 | escape }}"
                  data-option3="{{ variant.option3 | escape }}"
                  {% if variant == current_variant %}
                    selected
                  {% endif %}
                >
                  {{ variant.title }}
                </option>
              {% endfor %}
            </select>

            <div class="product-purchase-row">
              <div class="product-quantity">
                <label
                  class="product-quantity__label"
                  for="Quantity-{{ section.id }}"
                >
                  Quantity
                </label>

                <div class="product-quantity__controls">
                  <button
                    type="button"
                    class="product-quantity__button"
                    data-quantity-minus
                    aria-label="Decrease quantity"
                  >
                    &minus;
                  </button>

                  <input
                    id="Quantity-{{ section.id }}"
                    class="product-quantity__input"
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    step="1"
                  >

                  <button
                    type="button"
                    class="product-quantity__button"
                    data-quantity-plus
                    aria-label="Increase quantity"
                  >
                    +
                  </button>
                </div>
              </div>

              <button
                type="submit"
                name="add"
                class="main-btn"
                data-add-to-cart
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                <span data-add-to-cart-text>
                  {% if current_variant.available %}
                    Add to cart
                  {% else %}
                    Sold out
                  {% endif %}
                </span>
              </button>
            </div>

            {% if section.settings.show_dynamic_checkout %}
              <div class="product-dynamic-checkout">
                {{ form | payment_button }}
              </div>
            {% endif %}
          {% endform %}

          {% comment %}
            {% if product.description != blank %}
              <div class="extra-info-item">
                <button
                  type="button"
                  class="product-description-toggle"
                  aria-expanded="false"
                  aria-controls="product-description-{{ section.id }}"
                >
                  <span id="desc">Description</span>

                  <span class="accordion-icon" aria-hidden="true"> + </span>
                </button>

                <div
                  id="product-description-{{ section.id }}"
                  class="product-description-content"
                >
                  <div class="product-description rte">
                    {{ product.description }}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endcomment %}

          {% assign growing = product.metafields.custom.growing_instructions.value %}
          {% assign seed_info = product.metafields.custom.seed_information.value %}
          {% assign uses = product.metafields.custom.uses.value %}
          {% assign additional = product.metafields.custom.additional_information.value %}

          {% if growing != blank
            or seed_info != blank
            or uses != blank
            or additional != blank
            or product.description != blank
          %}
            <div class="extra-info-container">
              <div class="extra-info-wrapper">
                <div class="extra-info-item">
                  <button
                    type="button"
                    class="extra-info-toggle"
                    aria-expanded="false"
                  >
                    <span>Description</span>
                    <span class="extra-info-icon" aria-hidden="true">+</span>
                  </button>

                  <div class="extra-info-content" id="desc-info">
                    <div class="extra-info-content-inner">
                      {{ product.description }}
                      {% comment %}
                        <ul>
                          {% for item in growing %}
                            <li>{{ item }}</li>
                          {% endfor %}
                        </ul>
                      {% endcomment %}
                    </div>
                  </div>
                </div>
                {% if growing != blank %}
                  <div class="extra-info-item">
                    <button
                      type="button"
                      class="extra-info-toggle"
                      aria-expanded="false"
                    >
                      <span>Growing Instructions</span>
                      <span class="extra-info-icon" aria-hidden="true">+</span>
                    </button>

                    <div class="extra-info-content">
                      <div class="extra-info-content-inner">
                        <ul>
                          {% for item in growing %}
                            <li>{{ item }}</li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  </div>
                {% endif %}

                {% if seed_info != blank %}
                  <div class="extra-info-item">
                    <button
                      type="button"
                      class="extra-info-toggle"
                      aria-expanded="false"
                    >
                      <span>Seed Information</span>
                      <span class="extra-info-icon" aria-hidden="true">+</span>
                    </button>

                    <div class="extra-info-content">
                      <div class="extra-info-content-inner">
                        <ul>
                          {% for item in seed_info %}
                            <li>{{ item }}</li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  </div>
                {% endif %}

                {% if uses != blank %}
                  <div class="extra-info-item">
                    <button
                      type="button"
                      class="extra-info-toggle"
                      aria-expanded="false"
                    >
                      <span>Uses</span>
                      <span class="extra-info-icon" aria-hidden="true">+</span>
                    </button>

                    <div class="extra-info-content">
                      <div class="extra-info-content-inner">
                        <ul>
                          {% for item in uses %}
                            <li>{{ item }}</li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  </div>
                {% endif %}

                {% if additional != blank %}
                  <div class="extra-info-item">
                    <button
                      type="button"
                      class="extra-info-toggle"
                      aria-expanded="false"
                    >
                      <span>Additional Information</span>
                      <span class="extra-info-icon" aria-hidden="true">+</span>
                    </button>

                    <div class="extra-info-content">
                      <div class="extra-info-content-inner">
                        <ul>
                          {% for item in additional %}
                            <li>{{ item }}</li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% style %}
            .accelerated-checkout-button {
              background: var(--black);
            }
            .extra-info-wrapper {
              width: 100%;
            }

            .extra-info-item {
              width: 100%;
            }

            #desc-info p:last-of-type {
              padding-bottom: 5%;
            }

            .extra-info-toggle {
              width: 100%;
              padding: 16px 0;

              display: flex;
              align-items: center;
              justify-content: space-between;
              gap: 20px;

              background: transparent;
              border: 0;

              font: inherit;
              font-weight: 600;
              text-align: left;

              cursor: pointer;
            }

            .extra-info-icon {
              font-size: 22px;
              line-height: 1;
              flex-shrink: 0;
            }

            /* CLOSED */
            .extra-info-content {
              display: grid;
              grid-template-rows: 0fr;

              transition: grid-template-rows 0.35s ease;
            }

            .extra-info-content-inner {
              overflow: hidden;
              display: flex;
              flex-direction: column;
              gap: 1em;
            }

            /* OPEN */
            .extra-info-item.is-open .extra-info-content {
              grid-template-rows: 1fr;
            }

            .extra-info-content-inner ul {
              margin: 0;
              padding: 0 0 18px 20px;
            }
          {% endstyle %}

          {% comment %}
            {% assign growing = product.metafields.custom.growing_instructions.value %}
            {% assign seed_info = product.metafields.custom.seed_information.value %}
            {% assign uses = product.metafields.custom.uses.value %}
            {% assign additional = product.metafields.custom.additional_information.value %}

            {% if growing != blank or seed_info != blank or uses != blank or additional != blank %}
              <div class="extra-info-container">
                <div class="extra-info-wrapper">
                  {% if growing != blank %}
                    <div class="extra-info-item">
                      <h2>Growing Instructions</h2>
                      <ul>
                        {% for item in growing %}
                          <li>{{ item }}</li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if seed_info != blank %}
                    <div class="extra-info-item">
                      <h2>Seed Information</h2>
                      <ul>
                        {% for item in seed_info %}
                          <li>{{ item }}</li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if uses != blank %}
                    <div class="extra-info-item">
                      <h2>Uses</h2>
                      <ul>
                        {% for item in uses %}
                          <li>{{ item }}</li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if additional != blank %}
                    <div class="extra-info-item">
                      <h2>Additional Information</h2>
                      <ul>
                        {% for item in additional %}
                          <li>{{ item }}</li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endcomment %}

          {% comment %}
            <div class="extra-info-container">
              <div class="extra-info-wrapper">
                <div class="extra-info-item"></div>
                <div class="extra-info-item"></div>
                <div class="extra-info-item"></div>
                <div class="extra-info-item"></div>
              </div>
            </div>
          {% endcomment %}

          {% stylesheet %}
            .extra-info-container {
              width: 100%;
              height: auto;
              display: flex;
              align-items: center;
              justify-content: center;
              margin-top: 1em;
            }

            .extra-info-wrapper {
              width: 100%;
              height: auto;
              display: flex;
              flex-direction: column;
              gap: 1em;
              /* display: grid;
              grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
              gap: 1em; */
            }

            .extra-info-item {
              width: 100%;
              height: auto;
              border: 1px solid var(--black);
              border-radius: var(--radius);
              padding: 0 5%;
            }

            .extra-info-item h2 {
              margin-bottom: 1em;
              font-size: 1.15em;
            }

            .extra-info-item ul {
              padding-inline-start: 20px;
            }

            .extra-info-item ul li {
              margin-bottom: 10px;
            }
          {% endstylesheet %}

          {% comment %}
            {% if product.description != blank %}
              <div class="product-description rte">
                {{ product.description }}
              </div>
            {% endif %}
          {% endcomment %}

          {% if section.settings.show_sku %}
            <p
              class="product-sku"
              data-product-sku
              {% if current_variant.sku == blank %}
                hidden
              {% endif %}
            >
              <strong>SKU:</strong>
              <span>{{ current_variant.sku }}</span>
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
      .product-section--{{ section.id }} {
        --product-text-color: {{ section.settings.text_color }};
        --product-button-background: {{ section.settings.button_background }};
        --product-button-color: {{ section.settings.button_text_color }};
        --product-border-color: rgba(18, 18, 18, 0.18);
        --product-page-width: {{ section.settings.page_width }}px;

        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        color: var(--product-text-color);
      }

      .product-section--{{ section.id }} * {
        box-sizing: border-box;
      }

      .product-page-width {
        width:100%;
        max-width:var(--max-inner-width);
        /* width: min(
          calc(100% - 3rem),
          var(--product-page-width)
        ); */
        margin: 0 auto;
      }

      .product-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(340px, 0.75fr);
        gap: clamp(3rem, 6vw, 8rem);
        align-items: start;
      }

      /*
       * Media
       */

      /*
     * Product gallery
     */

    .product-media {
      min-width: 0;
    }

    .product-gallery {
      display: grid;
      grid-template-columns: 90px minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }


    /*
     * Thumbnail column
     */

    .product-media__thumbnails {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .product-media__thumbnail {
      display: block;
      width: 90px;
      height: 90px;
      padding: 0;
      overflow: hidden;
      border-radius:10px;

      border: 1px solid transparent;
      background: #f3f3f3;

      cursor: pointer;

      transition:
        border-color 150ms ease,
        opacity 150ms ease;
    }

    .product-media__thumbnail:hover {
      opacity: 0.75;
    }

    .product-media__thumbnail.is-active {
      border-color: #121212;
    }

    .product-media__thumbnail-image {
      display: block;

      width: 100%;
      height: 100%;

      object-fit: cover;
    }


    /*
     * Large selected media
     */

    .product-media__main {
      position: relative;
      width: 100%;
      min-width: 0;
    }

    .product-media__item {
      display: none;
      border-radius:10px;
      border-top-right-radius:50px;
      width: 100%;

      overflow: hidden;
      background: #f3f3f3;
    }

    .product-media__item.is-active {
      display: block;
    }

    @media screen and (max-width:500px) {
      .product-media__item.is-active {
        margin-top:2em;
      }
    }

    .product-media__image,
    .product-media__video,
    .product-media__model {
      display: block;

      width: 100%;
      height: auto;
    }

    .product-media__image {
      width: 100%;
      height: auto;

      object-fit: contain;
    }

    .product-media__video,
    .product-media__model {
      aspect-ratio: 1 / 1;

      object-fit: contain;
    }


    /*
     * Placeholder
     */

    .product-media__placeholder {
      width: 100%;

      background: #f3f3f3;
    }

    .product-media__placeholder svg {
      display: block;

      width: 100%;
      height: auto;
    }

      /*
       * Product information
       */

      .product-details {
        min-width: 0;
      }

      .product-details__inner {
        position: sticky;
        top: 2rem;
      }

      .product-vendor {
        margin: 0 0 0.75rem;
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.7;
      }

      .product-title {
        margin: 0;
        font-size: clamp(2rem, 2.5vw, 3rem);
        line-height: 1.1;
        font-weight: 600;
        color:var(--black);
      }

      .product-price {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1.5rem;
        font-size: 1.25rem;
      }

      .product-price__sale {
        color: #b3261e;
      }

      .product-price__compare {
        font-size: 1rem;
        opacity: 0.6;
      }

      .product-tax-notice {
        margin: 0.5rem 0 0;
        font-size: 0.8rem;
        opacity: 0.7;
      }

      /*
       * Variant buttons
       */

      .product-form {
        margin-top: 2rem;
      }

      .product-options {
        display: grid;
        gap: 1.5rem;
      }

      .product-option {
        margin: 0;
        padding: 0;
        border: 0;
      }

      .product-option__label {
        margin-bottom: 0.75rem;
        padding: 0;
        font-size: 0.9rem;
        font-weight: 600;
      }

      .product-option__values {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .product-option__values input {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
      }

      .product-option__values label {
        display: inline-flex;
        min-width: 3rem;
        min-height: 2.75rem;
        padding: 0.65rem 1rem;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--product-border-color);
        border-radius: 999px;
        background: transparent;
        font-size: 0.9rem;
        line-height: 1;
        cursor: pointer;
        transition:
          color 150ms ease,
          background-color 150ms ease,
          border-color 150ms ease;
      }

      .product-option__values label:hover {
        border-color: currentColor;
      }

      .product-option__values input:checked + label {
        color: #fff;
        background: #121212;
        border-color: #121212;
      }

      .product-option__values input:focus-visible + label {
        outline: 2px solid currentColor;
        outline-offset: 3px;
      }

      .product-variant-select {
        display: none;
      }

      /*
       * Quantity and cart button
       */

      .product-purchase-row {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 1rem;
        align-items: end;
        margin-top: 2rem;
      }

      .product-quantity__label {
        display: block;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
      }

      .product-quantity__controls {
        display: grid;
        grid-template-columns: 2.75rem 3rem 2.75rem;
        min-height: 3.25rem;
        border: 1px solid var(--product-border-color);
      }

      .product-quantity__button {
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        font-size: 1.2rem;
        cursor: pointer;
      }

      .product-quantity__input {
        width: 100%;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        text-align: center;
        appearance: textfield;
      }

      .product-quantity__input::-webkit-inner-spin-button,
      .product-quantity__input::-webkit-outer-spin-button {
        margin: 0;
        appearance: none;
      }

      .product-add-button {
        width: 100%;
        min-height: 3.25rem;
        padding: 0.9rem 1.5rem;
        border: 1px solid var(--product-button-background);
        border-radius: 10px;
        background: var(--product-button-background);
        color: var(--product-button-color);
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        transition:
          opacity 150ms ease,
          transform 150ms ease;
      }

      .product-add-button:hover:not(:disabled) {
        opacity: 0.85;
      }

      .product-add-button:active:not(:disabled) {
        transform: scale(0.99);
      }

      .product-add-button:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }

      .product-dynamic-checkout {
        margin-top: 1rem;
      }

      /*
       * Description
       */

      .product-description {
        margin-top: 2.5rem;
        font-size: 1rem;
        line-height: 1.7;
      }

      .product-description > :first-child {
        margin-top: 0;
      }

      .product-description img {
        max-width: 100%;
        height: auto;
      }

      .product-sku {
        margin-top: 1.5rem;
        font-size: 0.85rem;
        opacity: 0.7;
      }

      /* accordion style layout for description */

      .product-description-accordion {
        width: 100%;
        border-top: 1px solid #ddd;

{{ 'variables.css' | asset_url | stylesheet_tag }}

{% liquid

%}

{% style %}
  .section-{{ section.id }} {
    width: 100%;
    height:auto;
    /* padding: 5% 0; */
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    background-image: url({{ 'contour-light.svg' | asset_url }});
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }

  .grow-container {
    width:80%;
    height:auto;
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(350px,1fr));
    gap:3em;
    /* background-image: url('{{ "topo.svg" | asset_url }}');
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover; */
  }

  .grow-item {
    width:100%;
    height:auto;
    min-height:250px;
    border-radius:10px;
    box-shadow:10px 10px 20px #000;
  }

  .grow-item:first-of-type {
    background:#F8F9F6;
    border:1px solid #000;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .grow-item-inner {
    width:80%;
    height:auto;
  }

  .grow-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius:10px;
  }

  .transparent {
    width:100%;
    height:10em;
  }

  #transparent-top {
    background-image:linear-gradient(to bottom, #F8F9F6 25%, rgba(255,255,255 , .2) 100%);
    /* border:1px solid red; */
  }

  #transparent-bottom {
    background-image:linear-gradient(to bottom, rgba(255,255,255 , .2),#F8F9F6);
  }
{% endstyle %}
<section class="section-{{ section.id }} full-width">
  <div class="transparent" id="transparent-top"></div>
  <div class="grow-container">
    <div class="grow-item">
      <div class="grow-item-inner">
        {% if section.settings.heading != blank %}
          <div class="text-header">
            <h2>
              {% if section.settings.highlighted_heading != blank %}
                <span>{{ section.settings.highlighted_heading }}</span>
              {% endif %}

              {{ section.settings.heading }}
            </h2>
          </div>
        {% endif %}
        {% if section.settings.body_text != blank %}
          <div class="text-body-grow">
            {{ section.settings.body_text }}
          </div>
        {% endif %}
        {% if section.settings.button_text != blank %}
          <div class="custom-button-area">
            <a
              class="custom-btn"
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
    <div class="grow-item">
      {% if section.settings.left_image %}
        {{
          section.settings.left_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1200',
            sizes: '(min-width: 750px) 50vw, 100vw',
            alt: section.settings.left_image.alt
        }}
      {% endif %}
    </div>
  </div>
  <div class="transparent" id="transparent-bottom"></div>
</section>

{% javascript %}
{% endjavascript %}

{% schema %}
{
  "name": "Homepage Grow",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "highlighted_heading",
      "label": "Bold heading text",
      "default": "Custom"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Seed Packets"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Create personalized seed packets for weddings, events, promotions, and special occasions.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Custom Packets"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Homepage Grow"
    }
  ]
}
{% endschema %}

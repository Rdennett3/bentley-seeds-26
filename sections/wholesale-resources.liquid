{% comment %}
  Wholesale Resources Page
{% endcomment %}

<section
  id="CustomPage-{{ section.id }}"
  class="custom-page section-{{ section.id }}"
>
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h1 class="custom-page__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.content != blank %}
      <div class="custom-page__content rte">
        {{ section.settings.content }}
      </div>
    {% endif %}

    {% comment %}
      Add custom page content here
    {% endcomment %}
  </div>
</section>

{% stylesheet %}
  .custom-page {
    padding: 60px 0;
  }

  .custom-page__heading {
    margin: 0 0 30px;
  }

  .custom-page__content {
    margin-bottom: 30px;
  }

  @media screen and (max-width: 749px) {
    .custom-page {
      padding: 40px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wholesale resources",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ],
  "presets": [
    {
      "name": "Wholesale Resources"
    }
  ]
}
{% endschema %}
